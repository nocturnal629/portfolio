# Copy this file to .env.local and fill in the value, or run `vercel env pull .env.local`
# after connecting a Blob store to this project in the Vercel dashboard.
# Note: the token is scoped per-environment in Vercel's dashboard - make sure
# "Development" is checked on the store's connection, or `vercel env pull`
# won't be able to fetch it for local use.

# Vercel Blob (Storage tab -> Create Database -> Blob)
BLOB_READ_WRITE_TOKEN=

# --- Honeypot (src/middleware.ts) ---
# All optional. Without them the honeypot still logs hits to Vercel's
# Runtime Logs (search "[honeypot]"); these just add real-time alerting
# and a genuine tripwired AWS key instead of an inert fake one.

# Discord or Slack incoming-webhook URL to get pinged the moment someone
# requests a decoy secrets file or admin path.
HONEYPOT_WEBHOOK_URL=

# Generate a free AWS canary token at https://canarytokens.org (no signup)
# and paste its access key/secret here so the decoy .env serves a key
# that actually alerts you (by email or webhook, configured on
# canarytokens.org itself) the moment anyone tries to use it — not just
# a made-up string that goes nowhere.
HONEYPOT_AWS_ACCESS_KEY_ID=
HONEYPOT_AWS_SECRET_ACCESS_KEY=
